---
// Inline lucide-style icons (24x24, stroke-based) so no icon package is needed.
interface Props {
  name: 'lantern' | 'arrow-right' | 'arrow-up-right' | 'play' | 'youtube' | 'gamepad';
  size?: number;
  class?: string;
}
const { name, size = 24, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {name === 'lantern' && (
    <>
      <path d="M9 2h6" />
      <path d="M8 9a4 4 0 0 1 8 0v7a2 2 0 0 1-2 2h-4a2 2 0 0 1-2-2z" />
      <path d="M10 5h4" />
      <path d="M12 2v3" />
      <path d="M12 11v3" />
      <path d="M10 22h4" />
      <path d="M12 18v4" />
    </>
  )}
  {name === 'arrow-right' && (
    <>
      <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
    </>
  )}
  {name === 'arrow-up-right' && (
    <>
      <path d="M7 7h10v10" /><path d="M7 17 17 7" />
    </>
  )}
  {name === 'play' && <polygon points="6 3 20 12 6 21 6 3" fill="currentColor" />}
  {name === 'youtube' && (
    <>
      <path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17" />
      <path d="m10 15 5-3-5-3z" />
    </>
  )}
  {name === 'gamepad' && (
    <>
      <line x1="6" x2="10" y1="12" y2="12" /><line x1="8" x2="8" y1="10" y2="14" />
      <line x1="15" x2="15.01" y1="13" y2="13" /><line x1="18" x2="18.01" y1="11" y2="11" />
      <rect width="20" height="12" x="2" y="6" rx="2" />
    </>
  )}
</svg>
