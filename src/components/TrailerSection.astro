---
import Icons from './Icons.astro';
import { links } from '../lib/site';
---

<section id="trailer" class="bg-black pt-6 md:pt-10 pb-20 md:pb-32 px-6 overflow-hidden scroll-mt-24">
  <div class="max-w-6xl mx-auto">
    <div class="reveal rounded-3xl overflow-hidden aspect-video bg-black ring-1 ring-white/10" style="--reveal-y: 60px; --reveal-duration: 0.9s">
      <iframe
        class="w-full h-full"
        src={links.trailerEmbed}
        title="The Room That Remembers trailer"
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>

    <div class="reveal mt-6 md:mt-8 flex flex-col md:flex-row md:items-end md:justify-between gap-6" style="--reveal-y: 30px; --reveal-delay: 0.15s">
      <div class="liquid-glass rounded-2xl p-6 md:p-8 max-w-md">
        <p class="text-white/50 text-xs tracking-widest uppercase mb-3">The memory</p>
        <p class="text-white text-sm md:text-base leading-relaxed">
          The photograph was taken in the family study at half past six, on an ordinary evening. The house remembers the feeling of it. You have forgotten everything but that.
        </p>
      </div>
      <a
        href={links.play}
        target="_blank"
        rel="noopener"
        class="liquid-glass rounded-full px-8 py-3 text-white text-sm font-medium inline-flex items-center gap-2 self-start md:self-auto transition-transform hover:scale-105 active:scale-95"
      >
        Play on itch.io
        <Icons name="arrow-up-right" size={16} />
      </a>
    </div>
  </div>
</section>
