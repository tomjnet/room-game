---
import Icons from './Icons.astro';
import { asset, links } from '../lib/site';
---

<section class="relative bg-black overflow-hidden">
  <div class="relative min-h-[70vh] flex items-center justify-center px-6 py-28">
    <img
      src={asset('images/house-dawn.jpg')}
      alt=""
      class="absolute inset-0 w-full h-full object-cover opacity-70"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black via-black/40 to-black"></div>

    <div class="reveal relative z-10 text-center max-w-3xl" style="--reveal-y: 40px">
      <p class="font-serif text-3xl md:text-5xl lg:text-6xl text-white leading-[1.15] tracking-tight mb-4">
        Half past six. The clock keeps time, the flower is open, the music plays through.
      </p>
      <p class="font-serif italic text-2xl md:text-3xl text-white/70 mb-10">The house is warm again.</p>
      <a
        href={links.play}
        target="_blank"
        rel="noopener"
        class="liquid-glass rounded-full pl-8 pr-2 py-2 inline-flex items-center gap-4 text-white text-sm md:text-base font-medium group"
      >
        Play free in your browser
        <span class="bg-white rounded-full p-3 text-black transition-transform group-hover:translate-x-0.5">
          <Icons name="arrow-right" size={20} />
        </span>
      </a>
    </div>
  </div>
</section>

<footer class="bg-black px-6 pb-12 pt-6">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6 text-white/40 text-xs">
    <p>
      The Room That Remembers. Made solo by TomJNET, October 2026.
    </p>
    <div class="flex items-center gap-3">
      <a href={links.play} target="_blank" rel="noopener" aria-label="Play on itch.io" class="liquid-glass rounded-full p-3 text-white/60 hover:text-white hover:bg-white/5 transition-all">
        <Icons name="gamepad" size={16} />
      </a>
      <a href={links.trailer} target="_blank" rel="noopener" aria-label="Trailer on YouTube" class="liquid-glass rounded-full p-3 text-white/60 hover:text-white hover:bg-white/5 transition-all">
        <Icons name="youtube" size={16} />
      </a>
    </div>
  </div>
</footer>
